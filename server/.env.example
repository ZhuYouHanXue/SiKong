# 司空服务端配置。以下为运行必需项；其余调优/覆盖项见 server 源码默认值。

# 监听地址与端口
# HOST=127.0.0.1
# PORT=8787

# 模型请求超时
# SIKONG_LLM_TIMEOUT=30000
# SIKONG_LLM_PROBE_TIMEOUT=8000

# 模型配置（provider / baseUrl / model / apiKey）以 server/model-config.json 为准，
# 网页设置里修改会写入该文件。此处无需重复配置，原生仅支持 DeepSeek。

# 「失算」小游戏
# 若服务部署在 Nginx 等反向代理之后，设为 1 才能按真实用户 IP 做频率限制
# SIKONG_TRUST_PROXY=0
# 每个 IP 每小时最多尝试次数（每次尝试约调用 DeepSeek 10 到 30 次）
# SHISUAN_PER_HOUR=60
