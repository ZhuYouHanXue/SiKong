{
  "name": "sikong-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --watch server/server.mjs",
    "quickstart": "node scripts/start.mjs",
    "build": "vite build",
    "start": "node server/server.mjs",
    "start:server": "node server/server.mjs",
    "preview": "pnpm build && node server/server.mjs",
    "test:server": "node server/test/smoke.mjs && node server/test/mock-contract.mjs",
    "check": "pnpm test:server && pnpm build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.14"
  }
}
